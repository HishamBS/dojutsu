{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "rinnegan/**/*.ts",
    "byakugan/**/*.ts",
    "rasengan/**/*.ts",
    "dojutsu/**/*.ts",
    "setup-quality-gates/**/*.ts",
    "../violation_scanner.ts"
  ],
  "exclude": ["**/fixtures/**", "**/node_modules/**"],
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@quality/*": ["./dojutsu/scripts/common/*"],
      "@quality-test/*": ["./dojutsu/tests/support/*"],
      "@rinnegan/*": ["./rinnegan/scripts/*"],
      "@byakugan/*": ["./byakugan/scripts/*"],
      "@rasengan/*": ["./rasengan/scripts/*"],
      "@dojutsu/*": ["./dojutsu/scripts/*"],
      "@setup/*": ["./setup-quality-gates/scripts/*"]
    }
  }
}
